\newlabel{eq:onset}{{16}{3}{4. Phase diagram and control implications}{equation.0.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Fixed-fraction homogeneous-population phase diagrams.} $\gamma _2=\gamma _4=2$ and $\lambda _E=\lambda _p=\lambda _4=\lambda _2=\lambda _0$; the vertical coordinate is $\lambda _1/\lambda _2$. Panels (b)--(d) use $(\rho ^{(1)}_{2\times 1},\rho ^{(1)}_{4\times 1})=(1/2,3/8)$ and $(\rho ^{(2)}_{2\times 1},\rho ^{(2)}_{4\times 1},\rho ^{(2)}_{2\times 2})=(1/16,1/8,1/4)$. (a) Pure-ReLU reference. (b) At finite width, saturation produces a genuine mixed strip and moves the direct/compositional crossover. (c) Composition share; gray means no active block-2 target. The white line is $P/S=1/\sqrt  8$ and is only the weak-signal diagnostic. (d) Multiplying every population size by 16 moves each neuron into its linear regime, shrinks the mixed strip, and approaches panel (a). Each panel is a multistart numerical minimization of the displayed reduced free energy.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:phase}{{1}{3}{\textbf {Fixed-fraction homogeneous-population phase diagrams.} $\gamma _2=\gamma _4=2$ and $\lambda _E=\lambda _p=\lambda _4=\lambda _2=\lambda _0$; the vertical coordinate is $\lambda _1/\lambda _2$. Panels (b)--(d) use $(\rho ^{(1)}_{2\times 1},\rho ^{(1)}_{4\times 1})=(1/2,3/8)$ and $(\rho ^{(2)}_{2\times 1},\rho ^{(2)}_{4\times 1},\rho ^{(2)}_{2\times 2})=(1/16,1/8,1/4)$. (a) Pure-ReLU reference. (b) At finite width, saturation produces a genuine mixed strip and moves the direct/compositional crossover. (c) Composition share; gray means no active block-2 target. The white line is $P/S=1/\sqrt 8$ and is only the weak-signal diagnostic. (d) Multiplying every population size by 16 moves each neuron into its linear regime, shrinks the mixed strip, and approaches panel (a). Each panel is a multistart numerical minimization of the displayed reduced free energy}{figure.1}{}}
\newlabel{eq:simplices}{{17}{3}{4. Phase diagram and control implications}{equation.0.17}{}}
\newlabel{eq:fopt}{{18}{3}{4. Phase diagram and control implications}{equation.0.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Phase and active fractions after minimizing Eq.\nobreakspace  {}\textup  {\hbox {\mathsurround \z@ \normalfont  (\ignorespaces \ref  {eq:fopt}\unskip \@@italiccorr )}}.} $N_1=N_2=64$ and all loss weights and decay conventions match Fig.\nobreakspace  {}\ref  {fig:phase}. (a) The optimized phase. (b)--(c) Active first-block fractions. (d)--(f) Active second-block fractions. Unshown mass is idle. In this slice the optimizer finds no stable mixed block-2 target phase: allowing the allocation to move relieves the fixed-capacity saturation that made the mixed strip in Fig.\nobreakspace  {}\ref  {fig:phase}(b). The diagrams are multistart numerical global-search approximations to the displayed eleven-dimensional free energy.}}{4}{figure.2}\protected@file@percent }
\newlabel{fig:optimized-fractions}{{2}{4}{\textbf {Phase and active fractions after minimizing Eq.~\eqref {eq:fopt}.} $N_1=N_2=64$ and all loss weights and decay conventions match Fig.~\ref {fig:phase}. (a) The optimized phase. (b)--(c) Active first-block fractions. (d)--(f) Active second-block fractions. Unshown mass is idle. In this slice the optimizer finds no stable mixed block-2 target phase: allowing the allocation to move relieves the fixed-capacity saturation that made the mixed strip in Fig.~\ref {fig:phase}(b). The diagrams are multistart numerical global-search approximations to the displayed eleven-dimensional free energy}{figure.2}{}}
